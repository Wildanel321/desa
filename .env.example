# Konfigurasi server lokal
PORT=3000

# Kunci rahasia untuk token sesi admin demo (ubah untuk lingkungan produksi)
AUTH_SECRET=toyamas-demo-secret-key-2026

# Kredensial akun admin demo (opsional, gunakan default jika dikosongkan)
DEMO_ADMIN_EMAIL=admin@toyamas.desa.id
DEMO_ADMIN_PASSWORD=toyamas2026

# Opsional: Konfigurasi API Gemini jika ingin mengaktifkan analisis AI eksternal.
# Jika dikosongkan, aplikasi otomatis berjalan pada Mode Simulasi Lokal.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
